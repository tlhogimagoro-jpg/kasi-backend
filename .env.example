# ─────────────────────────────────────────────
#  Kasi to Kasi Backend — Environment Variables
# ─────────────────────────────────────────────
#  Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/kasitokasi"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_too
JWT_REFRESH_EXPIRES_IN=30d

# Firebase Admin SDK
# Download your service account JSON from Firebase Console
# Project Settings → Service Accounts → Generate new private key
# Also enable "Phone" under Authentication → Sign-in method in Firebase Console
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Flutterwave (payments)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# CORS - comma-separated origins
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.co.za

# Fare calculation
BASE_FARE_RANDS=8.00
FARE_PER_KM_RANDS=2.50
MINIMUM_FARE_RANDS=12.00

# Payment split percentages (must add to 100)
DRIVER_SHARE_PERCENT=75
PLATFORM_SHARE_PERCENT=10
WORKSHOP_SHARE_PERCENT=8
ASSOCIATION_SHARE_PERCENT=7
